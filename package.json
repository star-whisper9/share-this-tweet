{
  "name": "share-this-tweet",
  "version": "0.2.1",
  "private": true,
  "description": "A Firefox extension for exporting and sharing X posts with their source context.",
  "type": "module",
  "license": "GPL-3.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
