{
  "manifest_version": 2,
  "name": "分享有据 · Share This Tweet",
  "version": "0.3.0",
  "incognito": "not_allowed",
  "description": "将 X 推文保存为卡片，为图片添加来源画框，复制带出处的文字。",
  "icons": {
    "16": "/icons/icon-16.png",
    "32": "/icons/icon-32.png",
    "48": "/icons/icon-48.png",
    "96": "/icons/icon-96.png",
    "128": "/icons/icon-128.png"
  },
  "browser_action": {
    "default_title": "分享有据 · Share This Tweet",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "/icons/icon-16.png",
      "32": "/icons/icon-32.png",
      "48": "/icons/icon-48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "share-this-tweet@f1a.me",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "clipboardWrite",
    "downloads",
    "storage",
    "https://x.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "background": {
    "scripts": ["/background/background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["/content/bootstrap.js"],
      "css": ["/styles/ui.css"],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    "/page/interceptor.js",
    "/icons/x.svg",
    "/icons/x.png",
    "/icons/icon-48.png",
    "/icons/grok.svg"
  ]
}
